# Copy this file to .env.local when local development should auto-login.
# Keep .env.local out of git and use only disposable development accounts here.
VITE_DEV_AUTO_LOGIN_USERNAME=client_flow_03562487
VITE_DEV_AUTO_LOGIN_PASSWORD=Test@1234

# 打开后开发者工作台总览改用演示数据（只在 vite dev 下生效，build/test 忽略）
# 不想改这个文件时，也可在地址上加 ?mock=1 临时打开
# VITE_DEV_HOME_MOCK=true

# 打开后整个客户端走假后端（src/mock/），不需要启动 8080 的后端
# 生效范围只有 pnpm dev；build 与单测永远拿不到 mock
# 也可以在地址上加 ?mock=1 临时打开，用 ?mockAs=dev 直接进开发者视角
# VITE_MOCK=true
# 假响应延迟毫秒数（默认 120），嫌慢可以调 0
# VITE_MOCK_DELAY=120
