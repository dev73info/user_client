{
  "name": "user_client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "submit:baidu": "node scripts/submit-baidu.mjs",
    "build": "run-s generate:sitemap type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:ci": "vitest run --exclude '**/.claude/**'",
    "build-only": "vite build && node scripts/generate-seo-pages.mjs",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "eslint . --max-warnings=0",
    "check:frontend": "node scripts/check-frontend.mjs .",
    "gate": "run-s type-check lint:check test:ci check:frontend contract:check build",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "format:changed": "bash -c \"CHANGED=$(git diff --name-only --diff-filter=ACMR origin/master...HEAD -- 'src/*.ts' 'src/**/*.ts' 'src/**/*.vue' 'src/*.css' 'src/**/*.css' 'scripts/*.mjs' 'scripts/**/*.mjs') || exit $?; if [ -n \\\"$CHANGED\\\" ]; then printf '%s\\n' \\\"$CHANGED\\\" | xargs prettier --check; else echo '没有改动的 .ts / .vue / .css / .mjs 文件'; fi\"",
    "contract:check": "node scripts/contract-check.mjs",
    "contract:write": "node scripts/contract-check.mjs --write",
    "gate:quick": "run-s type-check lint:check test:ci check:frontend contract:check"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^3.22.5",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-table-cell": "^3.24.0",
    "@tiptap/extension-table-header": "^3.24.0",
    "@tiptap/extension-table-row": "^3.24.0",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@tiptap/vue-3": "^3.22.3",
    "dompurify": "^3.4.5",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.1.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "tags-wasm": "link:../tags-wasm/pkg",
    "ui_73info": "link:../ui_73info",
    "vue": "^3.5.31",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^4.3.9"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/eslint-plugin": "^1.6.13",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "~1.57.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.13",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
