# Production API base URL.
# Leave blank if frontend and backend are served from the same origin.
VITE_API_BASE_URL=https://api.73info.cn
# Cloudflare Turnstile 站点密钥（sitekey，公开值，会渲染进浏览器，故可入库）。
# 生产必须显式写在这里：Vite 在生产模式也会加载 .env.local，而那里的 sitekey 是
# 本地联调挂件（只放行 localhost / 127.0.0.1）。本项缺失时 .env.local 的值会被打进线上包，
# 线上页面就挂载不出挂件（Cloudflare 报「无法加载网站域名」），拿不到 token → 后端 fail-closed 403。
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFTsI1IDjEn7zxSs

VITE_DEV_PORTAL_URL=https://dev.73info.cn
VITE_ROUTER_MODE=history
# 用户端维护模式：设为 true 后访问会重定向到 /maintenance.html
VITE_MAINTENANCE_MODE=false

# 百度普通收录（URL 推送）的站点。必须与 sitemap / canonical 的域名完全一致，
# 否则百度按「已验证站点」校验会整批返回 not_same_site。
# 令牌属于密钥，不要写在这里（本文件入库）：放 .env.local 的 BAIDU_PUSH_TOKEN 或命令行传入。
BAIDU_PUSH_SITE=https://73info.cn
