<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; frame-src 'self' https://openapi.alipay.com https://excashier.alipay.com https://unitradeprod.alipay.com https://challenges.cloudflare.com; media-src 'self' blob:; img-src 'self' https: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; connect-src 'self' https://api.73info.cn https://dev.73info.cn https://challenges.cloudflare.com"
    Header always set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # 静态快照是 `<路由>.html`（/community.html、/user/<name>/profile.html），无斜杠地址先补 .html，
  # 爬虫与直链访问才能拿到带正文的页面，而不是 SPA 外壳。
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]

  # 未命中快照的地址回落到 noindex 外壳，不要落回 /index.html（那是首页快照，会变成重复首页）。
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /spa-fallback.html [L]
</IfModule>